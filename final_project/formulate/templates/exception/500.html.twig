{# templates/exception/500.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Formulate • 500 Internal Server Error{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --bg-page:      #CCCCCC;
            --accent-main:  #F2613F;
            --text-dark:    #212121;
            --text-muted:   #424242;
            --box-bg:       #FFFFFF;
            --box-border:   #E0E0E0;
        }

        body {
            background: var(--bg-page);
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .error-wrap {
            width: 90%;
            max-width: 600px;
            padding: 2rem;
            text-align: center;
            transform: scale(0.78);
            transform-origin: center center;
            margin: 0 auto;
        }

        .error-video {
            width: 690px;
            max-width: 100%;
            border-radius: .5rem;
            margin-bottom: 1.5rem;
            display: block;
        }

        .error-title {
            font-size: 2.25rem;
            color: var(--text-dark);
            margin: 1rem 0 .5rem;
        }

        .error-text {
            color: var(--text-muted);
            margin-bottom: 2rem;
            line-height: 1.5;
        }

        .error-details {
            text-align: left;
            margin-bottom: 2rem;
        }

        .error-details h3 {
            margin: 1rem 0 .5rem;
            font-size: 1.125rem;
            color: var(--text-dark);
        }

        .error-box {
            background: var(--box-bg);
            border: 1px solid var(--box-border);
            border-radius: .25rem;
            padding: 1rem;
            font-family: Menlo, Consolas, monospace;
            font-size: .875rem;

            /* remove fixed height & scrollbars */
            max-height: none;
            overflow: visible;

            /* wrap long lines completely */
            white-space: pre-wrap;
            word-wrap: break-word;
            word-break: break-all;

            color: var(--text-dark);
        }

        .btn-back {
            background: var(--accent-main);
            color: #fff;
            border: none;
            padding: .75rem 1.5rem;
            border-radius: .25rem;
            text-decoration: none;
            transition: background .2s;
        }
        .btn-back:hover {
            background: #d85034;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="error-wrap">
        {# 500 animation video #}
        <video
            class="error-video"
            autoplay
            loop
            muted
            playsinline
        >
            <source src="{{ asset('videos/Internal Server Error 500.mp4') }}" type="video/mp4">
            Your browser does not support the video tag.
        </video>

        <h1 class="error-title">500 • Internal Server Error</h1>
        <p class="error-text">
            Oops! Something went wrong on our end.<br>
            Our engineers have been notified and are working on a fix.
        </p>

        <div class="error-details">
            <h3>Threw From File:</h3>
            <div class="error-box">
                {{ errorFile }}
                {% if errorLine is defined %}
                    <br><small>Line {{ errorLine }}</small>
                {% endif %}
            </div>

            <h3>Error Message:</h3>
            <div class="error-box">{{ errorMessage }}</div>

            {% if previousMessage is defined and previousMessage %}
                <h3>Previous Error:</h3>
                <div class="error-box">
                    {{ previousMessage }}
                    {% if previousLine is defined %}
                        <br><small>Line {{ previousLine }}</small>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <a href="{{ path('app_home_index') }}" class="btn-back">
            <i class="bi bi-house-door-fill me-1"></i> Back to Home
        </a>
    </div>
{% endblock %}
