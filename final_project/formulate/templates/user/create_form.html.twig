{# templates/user/create_form.html.twig #}
{% extends 'user_layout.html.twig' %}

{% block title %}Create Form{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('app_user_forms') }}">Forms</a> / Create Form
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .image-input { border:2px dashed #ccc; padding:1rem; text-align:center; cursor:pointer }
        .image-input img { max-width:100%; max-height:200px; display:block; margin:auto }
        .question, .option { border:1px solid #ddd; padding:1rem; margin-bottom:.5rem; background:#f9f9f9; position:relative }
        .question { cursor:grab }
        .option { cursor:grab; margin-left:1rem }
        .btn-remove { position:absolute; top:.25rem; right:1.25rem; background:transparent; border:none; font-size:1.2rem; line-height:1; color:#666; cursor:pointer }
        .btn-remove:hover { color:#000 }
        .controls a { cursor:pointer; color:#38BDF8; text-decoration:none }
        .controls a:hover { text-decoration:underline }
    </style>
    <style>
        #tagsList { display:flex; gap:.125rem; flex-wrap:wrap }
        #tagsList .tag-item {
            display:inline-flex;
            align-items:center;
            position: relative;     /* make remove button position itself here */
            padding: 0.25rem 0.5rem; /* give a little inner space so × isn’t cut off */
            margin-bottom: 0.125rem; /* keep your wrap spacing */
        }
        #tagsList .tag-item input { width:auto; min-width:150px }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-5">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('create_form') }}">

            <div class="mb-4">
                <label class="image-input" for="imageInput">
                    <span id="imagePrompt">Click or drop image here</span>
                    <img id="imagePreview" src="{{ asset('images/default_form.png') }}" style="display:none">
                </label>
                <input type="file" id="imageInput" name="image" accept="image/*" style="display:none">
            </div>

            <div class="mb-3">
                <label>Title</label>
                <input type="text" name="title" class="form-control" required>
            </div>
            <div class="mb-3">
                <label>Description</label>
                <textarea name="description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label>Type</label>
                <select name="type" class="form-select" required>
                    <option value="">Select type…</option>
                    <option value="survey">Survey</option>
                    <option value="quiz">Quiz</option>
                    <option value="poll">Poll</option>
                </select>
            </div>

            <div id="tagsContainer" class="mb-4">
                <label>Tags</label>
                <div id="tagsList"></div>
                <div class="controls"><a id="addTag">+ Add Tag</a></div>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" name="is_public" id="publicCheck" value="1">
                <label class="form-check-label" for="publicCheck">Make Public</label>
            </div>

            <div id="questionsContainer" class="mb-4">
                <h5>Questions</h5>
                <div class="controls mb-2"><a id="addQuestion">+ Add Question</a></div>
                <div id="questionsList"></div>
            </div>

            <button type="submit" class="btn btn-primary">Save Form</button>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let qIndex = 0, tIndex = 0;
            const questionsList = document.getElementById('questionsList');
            const tagsList      = document.getElementById('tagsList');

            // image preview
            document.getElementById('imageInput').addEventListener('change', e => {
                const file = e.target.files[0], img = document.getElementById('imagePreview');
                if (!file) return;
                const reader = new FileReader();
                reader.onload = ev => {
                    img.src = ev.target.result;
                    img.style.display = 'block';
                    document.getElementById('imagePrompt').style.display = 'none';
                };
                reader.readAsDataURL(file);
            });

            // add question
            document.getElementById('addQuestion').onclick = () => {
                const qi = qIndex++;
                const div = document.createElement('div');
                div.className = 'question';
                div.dataset.index = qi;
                div.innerHTML = `
          <button type="button" class="btn-remove removeQuestion">&times;</button>
          <div class="mb-2">
            <label>Question</label>
            <input type="text" name="questions[${qi}][text]" class="form-control" required>
          </div>
          <div class="mb-2">
            <label>Type</label>
            <select name="questions[${qi}][type]" class="form-select question-type" data-q="${qi}" required>
              <option value="">Choose…</option>
              <option value="radio">Multiple Choice</option>
              <option value="checkbox">Multiple Select</option>
              <option value="text">Text</option>
            </select>
          </div>
          <div class="options-list" data-q="${qi}"></div>
          <div class="controls"><a class="addOption" data-q="${qi}">+ Add Option</a></div>
        `;
                questionsList.appendChild(div);
            };

            // add tag
            document.getElementById('addTag').onclick = () => {
                const idx = tIndex++;
                const div = document.createElement('div');
                div.className = 'tag-item';
                div.innerHTML = `
                    <button type="button" class="btn-remove removeTag">&times;</button>
                    <input type="text" name="tags[${idx}]" class="form-control" placeholder="Tag name" required>`;
                tagsList.appendChild(div);
            };

            tagsList.addEventListener('click', e => {
                if (e.target.classList.contains('removeTag')) {
                    e.target.closest('.tag-item').remove();
                }
            });


            // delegate question & option events
            questionsList.addEventListener('click', e => {
                // remove question
                if (e.target.classList.contains('removeQuestion')) {
                    e.target.closest('.question').remove();
                    return;
                }
                // add option
                if (e.target.classList.contains('addOption')) {
                    const qi = e.target.dataset.q;
                    const type = questionsList.querySelector(`select[data-q="${qi}"]`).value;
                    if (!type || type === 'text') return;
                    const opts = questionsList.querySelector(`.options-list[data-q="${qi}"]`);
                    const oi = opts.children.length;
                    const div = document.createElement('div');
                    div.className = 'option mb-2';
                    div.innerHTML = `
            <button type="button" class="btn-remove removeOption">&times;</button>
            <input type="text" name="questions[${qi}][options][${oi}]" class="form-control d-inline-block w-75" placeholder="Option text" required>
          `;
                    opts.appendChild(div);
                }
                // remove option
                if (e.target.classList.contains('removeOption')) {
                    e.target.closest('.option').remove();
                }
            });

            // clear options when changing type
            questionsList.addEventListener('change', e => {
                if (e.target.classList.contains('question-type')) {
                    const qi = e.target.dataset.q;
                    const opts = questionsList.querySelector(`.options-list[data-q="${qi}"]`);
                    opts.innerHTML = '';
                }
            });

            // drag & drop
            new Sortable(questionsList, { animation:150, handle:'.question' });
            document.querySelectorAll('.options-list').forEach(el => {
                new Sortable(el, { group:'opts', animation:150, handle:'.option' });
            });
        });
    </script>
{% endblock %}
