{% extends 'user_layout.html.twig' %}

{% block title %}Forms{% endblock %}
{% block breadcrumb %}Forms{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        input[type="checkbox"].rowCheckbox,
        #selectAll { transform: scale(1.3); margin-right: .5rem; }
        .table-header { display: flex; justify-content: space-between; margin-bottom:1rem }
        .forms-table th, .forms-table td { padding:.75rem; border-bottom:1px solid #e9ecef }
        .forms-table tbody tr:hover td { background: rgba(0,0,0,0.03) }
        .forms-table tbody tr { cursor: pointer }
        .forms-table tbody tr td:first-child { cursor: default }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="table-container bg-white p-4 rounded shadow-sm">
            <div class="table-header">
                <input id="tableSearch" type="text" class="form-control w-50" placeholder="🔍 Search…" />
                <div>
                    <a href="{{ path('app_user_form_create') }}" class="btn btn-success">Create</a>
                    <button id="toggleBtn" class="btn btn-warning" disabled data-bs-toggle="modal" data-bs-target="#toggleModal">
                        Toggle Visibility
                    </button>
                    <button id="deleteBtn" class="btn btn-danger" disabled data-bs-toggle="modal" data-bs-target="#deleteModal">
                        Delete
                    </button>
                </div>
            </div>

            <table class="table forms-table mb-0">
                <thead>
                <tr>
                    <th style="width:2rem"><input type="checkbox" id="selectAll"></th>
                    <th>Title</th><th>Description</th><th>Visibility</th><th>Created At</th>
                </tr>
                </thead>
                <tbody id="tableBody">
                {% for form in forms %}
                    <tr
                        data-id="{{ form.id }}"
                        data-edit-url="{{ path('app_user_form_edit', { id: form.id }) }}"
                        STYLE="cursor: pointer"
                    >
                        <td><input type="checkbox" class="rowCheckbox" value="{{ form.id }}"></td>
                        <td>{{ form.title }}</td>
                        <td>{{ form.description|striptags|slice(0,50) ~ '…' }}</td>
                        <td>
                            {% if form.isPublic %}
                                <span class="badge bg-success">Public</span>
                            {% else %}
                                <span class="badge bg-secondary">Private</span>
                            {% endif %}
                        </td>
                        <td>{{ form.createdAt|date('Y-m-d') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <nav aria-label="Forms pagination" class="mt-3">
                <ul class="pagination justify-content-center" id="pagination"></ul>
            </nav>
        </div>
    </div>

    {# Delete confirmation modal #}
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete the selected form(s)?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="confirmDelete" class="btn btn-danger">Yes, Delete</button>
                </div>
            </div></div>
    </div>

    {# Toggle Visibility confirmation modal #}
    <div class="modal fade" id="toggleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Toggle Visibility</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    This will invert the visibility of the selected form(s). Continue?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="confirmToggle" class="btn btn-warning">Yes, Toggle</button>
                </div>
            </div></div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rowsPerPage = 5, bodyEl = document.getElementById('tableBody');
            let currentPage = 1;
            const allRows = Array.from(bodyEl.querySelectorAll('tr[data-id]'));
            let filtered = allRows.slice();
            const pagUl = document.getElementById('pagination'),
                searchIn = document.getElementById('tableSearch'),
                selectAll = document.getElementById('selectAll'),
                deleteBtn = document.getElementById('deleteBtn'),
                confirmDelete = document.getElementById('confirmDelete'),
                toggleBtn = document.getElementById('toggleBtn'),
                confirmToggle = document.getElementById('confirmToggle');

            function renderTable() {
                bodyEl.innerHTML = '';
                const start = (currentPage-1)*rowsPerPage;
                const page = filtered.slice(start, start+rowsPerPage);
                if (!page.length) {
                    bodyEl.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No matching records.</td></tr>';
                } else page.forEach(r=>bodyEl.appendChild(r));
                bindEvents(); updateButtons();
            }

            function renderPagination() {
                pagUl.innerHTML = '';
                const pages = Math.max(1, Math.ceil(filtered.length/rowsPerPage));
                for (let i=1;i<=pages;i++) {
                    const li = document.createElement('li');
                    li.className = 'page-item'+(i===currentPage?' active':'');
                    const a = document.createElement('a');
                    a.className = 'page-link'; a.href='#'; a.textContent=i;
                    a.onclick = e=>{e.preventDefault(); currentPage=i; renderTable(); renderPagination()};
                    li.appendChild(a); pagUl.appendChild(li);
                }
            }

            function filterRows() {
                const q = searchIn.value.trim().toLowerCase();
                filtered = allRows.filter(r=>
                    Array.from(r.cells).slice(1).some(td=>td.textContent.toLowerCase().includes(q))
                );
                currentPage = 1; renderTable(); renderPagination();
            }

            function bindEvents() {
                document.querySelectorAll('.rowCheckbox').forEach(cb => {
                    cb.onchange = updateButtons;
                    cb.onclick = e=>e.stopPropagation();
                });
                bodyEl.querySelectorAll('tr[data-edit-url]').forEach(r => {
                    r.addEventListener('click', e => {
                        // if you ever have checkboxes in the same row, ignore those
                        if (e.target.type !== 'checkbox') {
                            window.location.href = r.dataset.editUrl;
                        }
                    });
                });
            }

            function updateButtons() {
                const checked = document.querySelectorAll('.rowCheckbox:checked').length;
                deleteBtn.disabled = toggleBtn.disabled = checked===0;
                selectAll.indeterminate = checked>0 && checked<allRows.length;
                selectAll.checked = checked>0 && checked===allRows.length;
            }

            selectAll.onchange = ()=> {
                const on=selectAll.checked;
                document.querySelectorAll('.rowCheckbox').forEach(cb=>cb.checked=on);
                updateButtons();
            };
            searchIn.oninput = filterRows;

            renderTable(); renderPagination();

            function submitForm(actionRoute) {
                const ids = Array.from(document.querySelectorAll('.rowCheckbox:checked')).map(cb=>cb.value);
                if (!ids.length) return;
                const f = document.createElement('form');
                f.method='post'; f.action=actionRoute;
                f.innerHTML=`<input type="hidden" name="ids" value="${ids.join(',')}">`;
                document.body.appendChild(f); f.submit();
            }

            confirmDelete.onclick = ()=> submitForm('{{ path("app_user_forms_delete") }}');
            confirmToggle.onclick = ()=> submitForm('{{ path("app_user_forms_toggle") }}');
        });
    </script>
{% endblock %}
