{% extends 'user_layout.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block breadcrumb %}Dashboard{% endblock %}


{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Brand variables and card styles (copied from home page) */
        :root {
            --page-bg:      #CCCCCC;
            --card-bg:      #FFFFFF;
            --brand-char:   #212121;
            --brand-blue:   #447DA0;
            --brand-green:  #27AE60;
            --divider-gray: #E0E0E0;
        }

        /* Make the content area match the home page background */
        .content {
            background-color: var(--page-bg);
        }

        /* in your user_layout.html.twig <style> or in block stylesheets */
        body {
            background: var(--page-bg);  /* instead of the pale #f5f7fa */
        }


        /* Search Input */
        #searchInput {
            background-color: var(--card-bg);
            border: 1px solid var(--divider-gray);
            border-radius: .75rem;
            transition: border-color .2s, box-shadow .2s;
        }
        #searchInput:focus {
            border-color: var(--brand-blue);
            box-shadow: 0 0 0 .25rem rgba(68,125,160,0.2);
        }

        /* Cards */
        .form-card .card {
            background-color: var(--card-bg);
            border: none;
            border-radius: .75rem;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            transition: transform .2s, box-shadow .2s;
        }
        .form-card .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.15);
        }
        .card-img-top {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-top-left-radius: .75rem;
            border-top-right-radius: .75rem;
        }

        /* Text Coloring */
        .card-title { color: var(--brand-char); font-weight: 600; }
        .card-text  { color: var(--brand-char); }

        /* Footer Icons */
        .card-footer {
            background-color: var(--card-bg) !important;
            border-top: 1px solid var(--divider-gray) !important;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .card-footer small { color: var(--brand-char); font-size: .875rem; }
        .card-footer .bi-hand-thumbs-up-fill { color: var(--brand-green) !important; }
        .card-footer .bi-chat-dots-fill      { color: var(--brand-blue)  !important; }
    </style>
    <style>
        /* —————————————————————————
           Tweak the Like button styling
           ————————————————————————— */
        .card-footer .btn-link {
            /* remove link appearance */
            text-decoration: none !important;
            color: var(--brand-char) !important;
            background: none;
            border: none;
            padding: 0;
            display: inline-flex;
            align-items: center;
            cursor: pointer;
        }

        .card-footer .btn-link:focus,
        .card-footer .btn-link:hover {
            /* gentle color feedback on hover/focus */
            color: var(--brand-green) !important;
            text-decoration: none !important;
            box-shadow: none !important;
        }

        /* space between thumb and number */
        .card-footer .btn-link .like-count {
            margin-left: .25rem;
            font-size: .9rem;
        }

        /* make sure the filled thumb is green */
        .card-footer .btn-link .bi-hand-thumbs-up-fill {
            color: var(--brand-green) !important;
        }
    </style>
    <style>
        .modal-body .comment-box {
            background-color: var(--card-bg);
            border: 1px solid var(--divider-gray);
            border-radius: .5rem;
            padding: .75rem 1rem;
            margin-bottom: .75rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row mb-4">
            <div class="col-md-6 mx-auto">
                <input id="searchInput" type="text" class="form-control" placeholder="🔍 Search forms…" />
            </div>
        </div>

        <div class="row" id="formsContainer">
            {% for form in forms %}
                <div class="col-lg-4 col-md-6 mb-4 form-card" data-title="{{ form.title|lower }}">
                    <div class="card h-100 shadow-sm">
                        <img
                            src="{{ form.imageUrl ?: asset('images/default_form.png') }}"
                            onerror="this.onerror=null;this.src='{{ asset('images/default_form.png') }}';"
                            class="card-img-top"
                            alt="{{ form.title }}">
                        <div class="card-body bg-white">
                            <h5 class="card-title mb-3">{{ form.title }}</h5>
                            <p class="card-text">
                                {{ form.description|striptags|length > 100
                                ? form.description|striptags|slice(0,100) ~ '…'
                                : form.description|striptags
                                }}
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top d-flex align-items-center">
                            {# Like button/form #}
                            <form
                                method="post"
                                action="{{ path('app_user_toggle_like', {id: form.id}) }}"
                                class="d-inline me-3"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('toggle_like' ~ form.id) }}"
                                />
                                <button
                                    type="submit"
                                    class="btn btn-link p-0 m-0"
                                    title="{{ form.id in liked_ids ? 'Unlike' : 'Like' }}"
                                >
                                    <i class="bi
                                        {{ form.id in liked_ids
                                    ? 'bi-hand-thumbs-up-fill text-success'
                                    : 'bi-hand-thumbs-up'
                                    }}
                                    "></i>
                                    <span class="ms-1">{{ form.likesCount }}</span>
                                </button>
                            </form>

                            {# Comment trigger #}
                            <small class="ms-3">
                                <a
                                    href="#commentsModal{{ form.id }}"
                                    data-bs-toggle="modal"
                                    class="text-decoration-none text-reset"
                                >
                                    <i class="bi bi-chat-dots-fill"></i>
                                    {{ form.commentsCount }}
                                </a>
                            </small>
                        </div>
                    </div>
                </div>

                {# — Modal for this exact form — #}
                <div
                    class="modal fade"
                    id="commentsModal{{ form.id }}"
                    tabindex="-1"
                    aria-labelledby="commentsModalLabel{{ form.id }}"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5
                                    class="modal-title"
                                    id="commentsModalLabel{{ form.id }}"
                                >
                                    Comments for “{{ form.title }}”
                                </h5>
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                ></button>
                            </div>

                            <div class="modal-body">
                                {% set coms = comments_by[form.id] %}
                                {% if coms %}
                                    <ul class="list-unstyled">
                                        {% for c in coms %}
                                            <li class="mb-2 comment-box">
                                                <strong>{{ c.user.email }}</strong>
                                                <small class="text-muted">
                                                    — {{ c.createdAt|date('Y-m-d H:i') }}
                                                </small>
                                                <div>{{ c.content }}</div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="text-muted">No comments yet.</p>
                                {% endif %}
                            </div>

                            <div class="modal-footer flex-column">
                                <form
                                    method="post"
                                    action="{{ path('app_user_add_comment', {id: form.id}) }}"
                                    class="w-100 position-relative d-flex align-items-center"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('add_comment' ~ form.id) }}"
                                    />

                                    {# character counter #}
                                    <small
                                        id="counter{{ form.id }}"
                                        class="position-absolute top-0 start-0 text-muted ps-2 pt-1"
                                    >0/200</small>

                                    <textarea
                                        name="comment_text"
                                        class="form-control ps-5"
                                        rows="2"
                                        maxlength="200"
                                        placeholder="Write your comment…"
                                        oninput="
                                            const max = 200;
                                            if (this.value.length > max) this.value = this.value.slice(0, max);
                                            document.getElementById('counter{{ form.id }}').textContent =
                                            this.value.length + '/' + max;
                                        "
                                    ></textarea>

                                    <button
                                        type="submit"
                                        class="btn btn-primary ms-2"
                                    >Send</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            {% else %}
                <div class="col-12 text-center text-secondary">
                    Nobody created any forms yet.
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block quickButton %}
    <button class="fab"
            title="New Form"
            onclick="location.href='{{ path('app_home_test') }}'">
        <i class="bi bi-plus"></i>
    </button>
{% endblock %}

{% block javascripts %}
    <script>
        // Client-side search filtering
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const q = e.target.value.toLowerCase();
            document.querySelectorAll('.form-card').forEach(card => {
                card.style.display = card.dataset.title.includes(q) ? '' : 'none';
            });
        });
    </script>

    <script>
        // Auto-open the modal after POST
        document.addEventListener('DOMContentLoaded', () => {
            {% for id in open_modal %}
            new bootstrap.Modal(
                document.getElementById('commentsModal' + {{ id }})
            ).show();
            {% endfor %}
        });
    </script>
{% endblock %}
