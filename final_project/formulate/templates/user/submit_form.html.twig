{% extends 'user_layout.html.twig' %}

{% block title %}Submit  Form{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_user_index') }}"
                         style="cursor: pointer; color: #1e9c4e; text-decoration: none;"
                         onmouseover="this.style.textDecoration = 'underline'; this.style.color = '#38BDF8';"
                         onmouseout="this.style.textDecoration = 'none'; this.style.color = '#1e9c4e';"
    >Dashboard
    </a> / Submit Form
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card mb-4">
            <img src="{{ asset(template.image) }}" class="card-img-top form-image" style="width: 100%; height: 250px; object-fit: cover;" alt="Form image" onerror="this.onerror=null; this.src='{{ asset('images/default_form.png') }}';">
            <div class="card-body">
                <h3 class="card-title">{{ template.title }}</h3>
                <p class="card-text">{{ template.description }}</p>
                <p>
                    {% for tag in template.templateTags %}
                        <span class="badge bg-secondary">{{ tag.tag }}</span>
                    {% endfor %}
                </p>
            </div>
        </div>

        <form action="{{ path('app_user_form_submit',{id:template.id}) }}"
              method="post">
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            {% for question in template.questions %}
                <div class="mb-4">
                    <label class="form-label fw-bold">{{ loop.index }}. {{ question.title }}</label>
                    <input type="hidden" name="answers[{{ question.id }}][qid]" value="{{ question.id }}">

                    {% if question.type=='text' %}
                        <textarea name="answers[{{ question.id }}]" class="form-control" rows="3" required></textarea>

                    {% elseif question.type=='radio' %}
                        {% for option in question.options %}
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="answers[{{ question.id }}]"
                                       id="q{{ question.id }}o{{ option.id }}"
                                       value="{{ option.id }}"
                                       required>
                                <label class="form-check-label" for="q{{ question.id }}o{{ option.id }}">
                                    {{ option.text }}
                                </label>
                            </div>
                        {% endfor %}

                    {% elseif question.type=='checkbox' %}
                        {% for option in question.options %}
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="answers[{{ question.id }}][]"
                                       id="q{{ question.id }}c{{ option.id }}"
                                       value="{{ option.id }}">
                                <label class="form-check-label" for="q{{ question.id }}c{{ option.id }}">
                                    {{ option.text }}
                                </label>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            {% endfor %}

            <button type="submit" class="btn btn-success">Submit</button>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}



