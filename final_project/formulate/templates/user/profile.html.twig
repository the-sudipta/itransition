{% extends 'user_layout.html.twig' %}

{% block title %}Create Form{% endblock %}
{% block breadcrumb %}Profile{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Container centering & spacing */
        .profile-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 1rem;
        }

        /* Card styling */
        .profile-card {
            background: #ffffff;
            border-radius: 1.5rem;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            margin-bottom: 2rem;
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .profile-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        /* Headings */
        .profile-card h2 {
            font-size: 1.75rem;
            color: #2d3748;
            margin-bottom: 1rem;
        }

        /* Text */
        .profile-card p {
            font-size: 1rem;
            line-height: 1.6;
            color: #4a5568;
        }

        /* Form fields */
        .profile-card .form-group {
            margin-bottom: 1.5rem;
        }
        .profile-card label {
            display: block;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: .5rem;
        }
        .profile-card input[type="password"] {
            width: 100%;
            padding: .75rem 1rem;
            border: 1px solid #cbd5e0;
            border-radius: .75rem;
            font-size: 1rem;
            transition: border-color .2s ease, box-shadow .2s ease;
        }
        .profile-card input[type="password"]:focus {
            border-color: #48bb78;
            box-shadow: 0 0 0 4px rgba(72,187,120,0.2);
            outline: none;
        }

        /* Update button */
        .profile-card .btn-update {
            background-color: #48bb78;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            padding: .75rem 1.5rem;
            border: none;
            border-radius: 2rem;
            box-shadow: 0 8px 20px rgba(72,187,120,0.3);
            cursor: pointer;
            transition: background-color .2s ease, transform .1s ease;
        }
        .profile-card .btn-update:hover {
            background-color: #38a169;
            transform: translateY(-2px);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="profile-container">
        <div class="profile-card">
            <h2>Account Details</h2>
            <p><strong>Email:</strong> {{ email }}</p>
        </div>

        <div class="profile-card">
            <h2>Change Password</h2>
            {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.newPassword.first) }}
                {{ form_widget(form.newPassword.first) }}
                {{ form_errors(form.newPassword.first) }}
            </div>
            <div class="form-group">
                {{ form_label(form.newPassword.second) }}
                {{ form_widget(form.newPassword.second) }}
                {{ form_errors(form.newPassword.second) }}
            </div>
            <button type="submit" class="btn-update">Update Password</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
