{% extends 'user_layout.html.twig' %}

{% block title %}Profile{% endblock %}
{% block breadcrumb %}Profile{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Container centering & spacing */
        .profile-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 1rem;
        }

        /* Card styling */
        .profile-card {
            background: #ffffff;
            border-radius: 1.5rem;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            margin-bottom: 2rem;
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .profile-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        /* Headings */
        .profile-card h2 {
            font-size: 1.75rem;
            color: #2d3748;
            margin-bottom: 1rem;
        }

        /* Text */
        .profile-card p {
            font-size: 1rem;
            line-height: 1.6;
            color: #4a5568;
        }

        /* Form fields */
        .profile-card .form-group {
            margin-bottom: 1.5rem;
        }
        .profile-card label {
            display: block;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: .5rem;
        }
        .profile-card input[type="password"] {
            width: 100%;
            padding: .75rem 1rem;
            border: 1px solid #cbd5e0;
            border-radius: .75rem;
            font-size: 1rem;
            transition: border-color .2s ease, box-shadow .2s ease;
        }
        .profile-card input[type="password"]:focus {
            border-color: #48bb78;
            box-shadow: 0 0 0 4px rgba(72,187,120,0.2);
            outline: none;
        }

        /* Error messages */
        .profile-card .form-group ul {
            color: #F87171;
            margin: .25rem 0 0;
            padding-left: 1.5rem;
            list-style: none;
        }
        .profile-card .form-group ul li {
            margin: 0;
            font-size: .875rem;
        }


        /* Update button */
        .profile-card .btn-update {
            background-color: #48bb78;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            padding: .75rem 1.5rem;
            border: none;
            border-radius: 2rem;
            box-shadow: 0 8px 20px rgba(72,187,120,0.3);
            cursor: pointer;
            transition: background-color .2s ease, transform .1s ease;
        }
        .profile-card .btn-update:hover {
            background-color: #38a169;
            transform: translateY(-2px);
        }
    </style>

    <style>
        /* API Access card */
        .profile-card .api-access-group {
            margin-top: 2rem;
        }
        .profile-card .token-input-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: .5rem;
        }
        .profile-card #token-label {
            display: inline-block;
            max-width: 100%;
            background: #EDF2F7;
            padding: .5rem 1rem;
            border-radius: .75rem;
            font-family: monospace;
            word-break: break-all;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="profile-container">
        {# — Account Details — #}
        <div class="profile-card">
            <h2>Account Details</h2>
            <p><strong>Email:</strong> {{ email }}</p>
        </div>

        {# — Change Password — #}
        <div class="profile-card">
            <h2>Change Password</h2>
            {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.newPassword.first) }}
                {{ form_widget(form.newPassword.first) }}
                {{ form_errors(form.newPassword.first) }}
            </div>
            <div class="form-group">
                {{ form_label(form.newPassword.second) }}
                {{ form_widget(form.newPassword.second) }}
                {{ form_errors(form.newPassword.second) }}
            </div>
            <button type="submit" class="btn-update">Update Password</button>
            {{ form_end(form) }}
        </div>

        {# — Salesforce Connect Button — #}
        {# — Salesforce Connect Button — #}
        <div class="profile-card">
            <h2>Salesforce Integration</h2>

            {% set sf  = app.user.salesforceAccount %}
            {% set now = date() %}

            {% if sf is null %}
                {# never connected #}
                <a href="{{ path('salesforce_connect') }}"
                   style="background: #38BDF8; color: #fff; padding: .75rem 1.5rem; border-radius: 2rem;
                  box-shadow: 0 8px 20px rgba(56,189,248,0.3); text-decoration: none; display: inline-block;">
                    Connect to Salesforce
                </a>

            {% elseif sf.expiresAt is not null and sf.expiresAt < now %}
                {# explicitly expired #}
                <p>Your Salesforce connection has expired.</p>
                <a href="{{ path('salesforce_connect') }}"
                   style="background: #FB923C; color: #fff; padding: .75rem 1.5rem; border-radius: 2rem;
                  box-shadow: 0 8px 20px rgba(251,146,60,0.3); text-decoration: none; display: inline-block;">
                    Re-connect to Salesforce
                </a>

            {% else %}
                {# still connected (expiry in future, or no expiry set) #}
                {% if sf.expiresAt is not null %}
                    <p>Connected until {{ sf.expiresAt|date('Y-m-d H:i') }}.</p>
                    <a href="{{ path('salesforce_sync') }}"
                       style="background: #A78BFA; color: #fff; padding: .75rem 1.5rem; border-radius: 2rem;
                      box-shadow: 0 8px 20px rgba(167,139,250,0.3); text-decoration: none; display: inline-block;">
                        Sync Salesforce
                    </a>
                {% else %}
                    <p>Connected (no expiry set).</p>
                    <a href="{{ path('salesforce_sync') }}"
                       style="background: #A78BFA; color: #fff; padding: .75rem 1.5rem; border-radius: 2rem;
                      box-shadow: 0 8px 20px rgba(167,139,250,0.3); text-decoration: none; display: inline-block;">
                        Sync Salesforce
                    </a>
                {% endif %}
            {% endif %}
        </div>

        {# — API Access — #}
        <div class="profile-card">
            <h2>API Access</h2>
            <div class="api-access-group">
                <div class="token-input-group">
                    {% if app.user.apiToken is null %}
                        <span id="token-label">Not generated yet</span>
                        <form action="{{ path('api_token_generate') }}" method="POST" style="display:inline;">
                            <button
                                type="submit"
                                style="background:#D69E2E;color:#fff;padding:.5rem 1rem;border:none;border-radius:1rem;cursor:pointer;"
                            >Generate</button>
                        </form>
                    {% else %}
                        <span id="token-label">{{ app.user.apiToken.token }}</span>
                        <button
                            id="copy-token-btn"
                            type="button"
                            style="background:#D69E2E;color:#fff;padding:.5rem 1rem;border:none;border-radius:1rem;cursor:pointer;"
                        >Copy</button>
                        <form
                            action="{{ path('api_token_generate') }}"
                            method="POST"
                            style="display:inline;margin-left:.5rem;"
                        >
                            <button
                                type="submit"
                                style="background:#D69E2E;color:#fff;padding:.5rem 1rem;border:none;border-radius:1rem;cursor:pointer;"
                            >Re-generate</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const copyBtn    = document.getElementById('copy-token-btn');
            const tokenLabel = document.getElementById('token-label');
            if (copyBtn && tokenLabel) {
                copyBtn.addEventListener('click', () => {
                    navigator.clipboard.writeText(tokenLabel.textContent.trim()).then(() => {
                        const original   = copyBtn.textContent;
                        copyBtn.textContent      = 'Copied!';
                        copyBtn.style.background = '#48BB78';
                        setTimeout(() => {
                            copyBtn.textContent      = original;
                            copyBtn.style.background = '#D69E2E';
                        }, 5000);
                    });
                });
            }
        });
    </script>
{% endblock %}
