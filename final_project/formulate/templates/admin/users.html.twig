{% extends 'admin_layout.html.twig' %}

{% block title %}Users{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ─── EXISTING TABLE STYLES ───────────────────────────────────────────────── */
        input[type="checkbox"].rowCheckbox,
        #selectAll {
            transform: scale(1.3);
            margin-right: .5rem;
        }
        .table-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
        }
        .users-table th,
        .users-table td {
            padding: .75rem;
            border-bottom: 1px solid #e9ecef;
        }
        .users-table tbody tr:hover td {
            background: rgba(0,0,0,0.03);
        }
        .users-table tbody tr {
            cursor: pointer;
        }
        .users-table tbody tr td:first-child {
            cursor: default;
        }

        /* ─── CENTER THE ENTIRE CONTAINER ────────────────────────────────────────── */
        .container.py-5 {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-5">
        {# — Friendly header —————————————————————————————————————————————— #}
        <div class="mb-5 text-center">
            <h2>👋 Hello, Administrator!</h2>
            <p class="text-muted">
                Use the controls below to add new users, remove old accounts, or update existing profiles.
            </p>
        </div>

        <div class="table-container bg-white p-4 rounded shadow-sm" style="width:100%; max-width:1200px;">
            <div class="d-flex justify-content-between mb-3">
                <input id="tableSearch"
                       type="text"
                       class="form-control w-50"
                       placeholder="🔍 Search users…" />

                <div>
                    <a href="{{ path('admin_user_create') }}" class="btn btn-success">+ Add User</a>
                    <button id="deleteBtn"
                            class="btn btn-danger"
                            disabled
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal">
                        Delete
                    </button>
                </div>
            </div>

            <table class="table users-table mb-0">
                <thead>
                <tr>
                    <th style="width:2rem">
                        <input type="checkbox" id="selectAll">
                    </th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Created At</th>
                </tr>
                </thead>
                <tbody id="tableBody">
                {% for user in users %}
                    <tr data-id="{{ user.id }}"
                        data-edit-url="{{ path('admin_user_edit', { id: user.id }) }}">
                        <td>
                            <input type="checkbox"
                                   class="rowCheckbox"
                                   value="{{ user.id }}">
                        </td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.roles|join(', ') }}</td>
                        <td>{{ user.createdAt|date('Y-m-d') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <nav aria-label="Users pagination" class="mt-3">
                <ul class="pagination justify-content-center" id="pagination"></ul>
            </nav>
        </div>
    </div>

    {# — Delete confirmation modal ———————————————————————————————————— #}
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete the selected user(s)?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button id="confirmDelete"
                            class="btn btn-danger">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rowsPerPage   = 5,
                bodyEl        = document.getElementById('tableBody'),
                allRows       = Array.from(bodyEl.querySelectorAll('tr[data-id]')),
                pagUl         = document.getElementById('pagination'),
                searchIn      = document.getElementById('tableSearch'),
                selectAll     = document.getElementById('selectAll'),
                deleteBtn     = document.getElementById('deleteBtn'),
                confirmDelete = document.getElementById('confirmDelete');

            let filtered     = allRows.slice(),
                currentPage  = 1;

            function renderTable() {
                bodyEl.innerHTML = '';
                const start = (currentPage - 1) * rowsPerPage;
                const page  = filtered.slice(start, start + rowsPerPage);

                if (!page.length) {
                    bodyEl.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No records found.</td></tr>';
                } else {
                    page.forEach(r => bodyEl.appendChild(r));
                }
                bindRowEvents();
                updateDeleteBtn();
            }

            function renderPagination() {
                pagUl.innerHTML = '';
                const pages = Math.max(1, Math.ceil(filtered.length / rowsPerPage));
                for (let i = 1; i <= pages; i++) {
                    const li = document.createElement('li');
                    li.className = 'page-item' + (i===currentPage?' active':'');
                    const a  = document.createElement('a');
                    a.className = 'page-link';
                    a.href = '#';
                    a.textContent = i;
                    a.onclick = e => {
                        e.preventDefault();
                        currentPage = i;
                        renderTable();
                        renderPagination();
                    };
                    li.appendChild(a);
                    pagUl.appendChild(li);
                }
            }

            function filterRows() {
                const q = searchIn.value.trim().toLowerCase();
                filtered = allRows.filter(r =>
                    Array.from(r.cells).slice(1).some(td =>
                        td.textContent.toLowerCase().includes(q)
                    )
                );
                currentPage = 1;
                renderTable();
                renderPagination();
            }

            function bindRowEvents() {
                // row‐click ⇒ edit
                bodyEl.querySelectorAll('tr[data-id]').forEach(row => {
                    row.onclick = e => {
                        if (e.target.type !== 'checkbox') {
                            window.location = row.dataset.editUrl;
                        }
                    };
                });
                // checkbox toggles delete button
                bodyEl.querySelectorAll('.rowCheckbox').forEach(cb => {
                    cb.onchange = updateDeleteBtn;
                });
                selectAll.onchange = () => {
                    bodyEl.querySelectorAll('.rowCheckbox')
                        .forEach(cb => cb.checked = selectAll.checked);
                    updateDeleteBtn();
                };
            }

            function updateDeleteBtn() {
                deleteBtn.disabled = !bodyEl.querySelector('.rowCheckbox:checked');
            }

            function submitForm(actionRoute) {
                const ids = Array.from(document.querySelectorAll('.rowCheckbox:checked')).map(cb=>cb.value);
                if (!ids.length) return;
                const f = document.createElement('form');
                f.method='post'; f.action=actionRoute;
                f.innerHTML=`<input type="hidden" name="ids" value="${ids.join(',')}">`;
                document.body.appendChild(f); f.submit();
            }

            confirmDelete.onclick = ()=> submitForm('{{ path("admin_users_delete") }}');

            searchIn.addEventListener('input', filterRows);

            // initial
            renderTable();
            renderPagination();
        });
    </script>
{% endblock %}
