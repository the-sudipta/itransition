<link rel="icon" href="{{ asset('images/formulate_logo_icon.png') }}">
<link rel="stylesheet" href="https://fonts.cdnfonts.com/css/bookman-old-style"/>
<title>Formulate • Dashboard</title>

{% block stylesheets %}
    <style>
        body,html{margin:0;padding:0;height:100%;}
        body{background:#FFFFFF;box-shadow: inset 0 0 20vmin 0 #cccccc;}
        .wrap{
            position:relative;
            width:80vmin; height:80vmin;
            margin:0 auto;
            background:inherit;
            transform:scale(0.2) translatez(0px);
            opacity:0;
            transition:transform .5s, opacity .5s;
        }
        a {
            position: absolute;
            left: 0; top: 0;
            width: 47.5%; height: 47.5%;
            overflow: hidden;
            transform: scale(.5) translateZ(0px);
            background: #cccccc;
        }
        a div {
            height: 100%;
            background-size: 30% auto;
            background-repeat: no-repeat;
            background-position: center center; /* fallback */
            opacity: .5;
            transition: opacity .5s;
            border-radius: inherit;
        }

        a:nth-child(1){
            border-radius:40vmin 0 0 0;
            transform-origin: 110% 110%;
            transition:transform .4s .15s;
        }
        a:nth-child(1) div{
            background-color: #cccccc;
            background-image:url('https://unpkg.com/heroicons@2.0.13/24/outline/user-group.svg');
            background-position: 38% 38%;
        }
        a:nth-child(2){
            border-radius:0 40vmin 0 0;
            left:52.5%;
            transform-origin: -10% 110%;
            transition:transform .4s .2s;
        }
        a:nth-child(2) div{
            background-color: #cccccc;
            background-image:url('https://unpkg.com/heroicons@2.0.13/24/outline/document-text.svg');
            background-position: 64% 38%;
        }
        a:nth-child(3){
            border-radius:0 0 0 40vmin;
            top:52.5%;
            transform-origin: 110% -10%;
            transition:transform .4s .25s;
        }
        a:nth-child(3) div{
            background-color: #cccccc;
            background-image:url('https://unpkg.com/heroicons@2.0.13/24/outline/user-circle.svg');
            background-position: 40% 62%;
        }
        a:nth-child(4){
            border-radius:0 0 40vmin 0;
            top:52.5%; left:52.5%;
            transform-origin: -10% -10%;
            transition:transform .4s .3s;
        }
        a:nth-child(4) div{
            background-color: #cccccc;
            background-image: url('https://unpkg.com/heroicons@2.0.13/24/solid/arrow-right-on-rectangle.svg');
            background-position: 62% 62%;
        }
        a:nth-child(5){
            width:55%;height:55%;
            left:22.5%; top:22.5%;
            border-radius:50vmin;
            box-shadow:0 0 0 5vmin #FFFFFF; /* Responsible to create a distance between the outer nav-links a:nth-child(1) to a:nth-child(4) VS a:nth-child(5) */
            transform:scale(1);
        }
        a:nth-child(5) div{
            /*background-image: url('https://farm4.staticflickr.com/3766/12953056854_b8cdf14f21.jpg');*/
            background-image: url('{{ asset("images/formulate_logo.png") }}');
            background-color: #202227;
        }
        span {
            position: relative;
            display: block;
            margin: 0 auto;
            top: 45vmin;
            width: 10vmin;
            height: 10vmin;
            border-radius: 50%;
            background: #cccccc;
            transform: translateZ(0);
            overflow: hidden;
        }
        span span {
            position: absolute;
            /* fill its parent: */
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('{{ asset("images/formulate_logo_icon.png") }}');
            background-color: #202227;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
        }
        /* remove the pseudo‐bars */
        span span:before,
        span span:after {
            display: none;
        }
        span span:after, span span:before{
            content:'';
            position:absolute;
            left:0; top:-1.5vmin;
            width:100%; height:100%;
            background:inherit;
        }
        span span:after{
            top:1.5vmin;
        }
        span:hover + .wrap, .wrap:hover{
            transform:scale(.8) translateZ(0px);
            opacity:1;
        }
        span:hover + .wrap a, .wrap:hover a{
            transform:scale(1) translatez(0px);
        }
        a:hover div{
            opacity:1;
            transform:translatez(0px);
            background-color: rgba(30, 156, 78, 0.2) !important;
        }
    </style>

    <style>
        /* ────────────────────────────────────────────────────────────────────────── */
        /* Overall page layout: two columns, full-height */
        .admin-dashboard {
            display: flex;
            justify-content: space-between; /* left-align nav, right-align quote */
            align-items: center;
            padding: 2rem;
            height: 100vh;
            background: #FFFFFF;
        }
        /* Left column: logo + radial menu */
        .admin-dashboard__nav {
            /*flex: 0 0 auto;*/
            /*margin-right: 4rem;*/
            /*!* new: shift the whole nav left by 2rem *!*/
            /*transform: translateX(-5.5rem);*/
        }
        /* Right column: header + quote box */
        .admin-dashboard__info {
            flex: 1 1 auto;
            max-width: 45rem;
            color: #064E3B;
            font-family: 'Bookman Old Style', sans-serif;
            font-weight: bold;
        }
        .admin-dashboard__info h1 {
            font-size: 2.5rem;
            margin-bottom: .5rem;
        }
        .admin-dashboard__info p {
            font-size: 1.1rem;
            color: #555;
            line-height: 1.4;
        }
        .quote {
            margin-top: 2rem;
            padding: 1.5rem;
            background: #f7fefa; /* very light green */
            border-left: 4px solid #1e9c4e;
            border-radius: 4px;
            font-style: italic;
            color: #333;
        }
        .quote__author {
            margin-top: .75rem;
            text-align: right;
            font-size: .9rem;
            font-weight: bold;
            color: #1e9c4e;
        }
        /* Keep your existing radial-menu CSS scoped under .admin-dashboard__nav */
        .admin-dashboard__nav span,
        .admin-dashboard__nav .wrap,
        .admin-dashboard__nav a { /* …copy your radial menu rules here… */ }
    </style>
{% endblock %}

{% block body %}

    <div class="admin-dashboard">
        <div class="admin-dashboard__nav">
            {# your existing radial menu markup #}
            <span><span></span></span>
            <div class="wrap">
                <a href="{{ path('admin_users') }}"   title="Manage Users"><div></div></a>
                <a href="{{ path('admin_forms') }}"   title="Manage Forms"><div></div></a>
                <a href="{{ path('admin_profile') }}"    title="Profile"><div></div></a>
                <a href="{{ path('app_logout') }}"    title="Logout"><div></div></a>
                <a href="{{ path('admin_dashboard') }}" title="Dashboard"><div></div></a>
{#                <a><div></div></a> #}{# center logo, no href #}
            </div>
        </div>

        <div class="admin-dashboard__info">
            <h1>Administration Console</h1>
            <p>Welcome back, <strong style="color: #1e9c4e; cursor: pointer">{{ app.user.email|split('@')[0] }}</strong>. Here you can manage users, forms, and system settings.</p>

            <div class="quote" id="quoteBox">
                “The administrator is the guardian of order and the architect of efficiency.”
                <div class="quote__author">— Anonymous</div>
            </div>
        </div>

    </div>

{% endblock %}

