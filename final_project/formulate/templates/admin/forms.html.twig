{% extends 'admin_layout.html.twig' %}

{% block title %}Forms{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}


{% block body %}
    <div class="container py-5">
        <div class="table-controls mb-3 d-flex justify-content-between">
            <input id="search" class="form-control w-50" placeholder="Search…">
            <div>
                <button id="toggleBtn" class="btn btn-info" disabled data-bs-toggle="modal" data-bs-target="#modalToggle">Toggle Visibility</button>
                <button id="deleteBtn" class="btn btn-danger" disabled data-bs-toggle="modal" data-bs-target="#modalDelete">Delete</button>
            </div>
        </div>

        <table class="table mb-0">
            <thead>
            <tr>
                <th><input type="checkbox" id="selectAll"></th>
                <th>Title</th>
                <th>Description</th>
                <th>Vis.</th>
                <th>Created</th>
            </tr>
            </thead>
            <tbody id="tableBody">
            {% for f in forms %}
                <tr data-id="{{ f.id }}" data-edit-url="{{ path('admin_form_responses', { id: f.id }) }}">
                    <td>
                        <input type="checkbox" class="rowCheckbox" value="{{ f.id }}">
                    </td>
                    <td>{{ f.title }}</td>
                    <td>{{ f.description|striptags|slice(0,50) }}…</td>
                    <td>
                        {% if f.isPublic %}
                            <span class="badge bg-success">Public</span>
                        {% else %}
                            <span class="badge bg-secondary">Private</span>
                        {% endif %}
                    </td>
                    <td>{{ f.createdAt|date('Y-m-d') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <nav>
            <ul class="pagination justify-content-center" id="pagination"></ul>
        </nav>
    </div>

    {# Toggle Modal #}
    <div class="modal fade" id="modalToggle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Confirm</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">Toggle visibility?</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="confirmToggle" class="btn btn-info">Yes</button>
                </div>
            </div>
        </div>
    </div>

    {# Delete Modal #}
    <div class="modal fade" id="modalDelete">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Confirm</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">Delete these forms?</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="confirmDelete" class="btn btn-danger">Yes</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const rowsPerPage = 5,
                bodyEl = document.getElementById('tableBody'),
                allRows = Array.from(bodyEl.querySelectorAll('tr[data-id]')),
                pagUl = document.getElementById('pagination'),
                searchIn = document.getElementById('search'),
                selectAll = document.getElementById('selectAll'),
                toggleBtn = document.getElementById('toggleBtn'),
                deleteBtn = document.getElementById('deleteBtn'),
                confirmToggle = document.getElementById('confirmToggle'),
                confirmDelete = document.getElementById('confirmDelete');
            let filtered = allRows.slice(), page = 1;

            function render() {
                bodyEl.innerHTML = '';
                const start = (page - 1) * rowsPerPage,
                    slice = filtered.slice(start, start + rowsPerPage);
                if (!slice.length) {
                    bodyEl.innerHTML = '<tr><td colspan="5" class="text-center">No results</td></tr>';
                } else {
                    slice.forEach(r => bodyEl.appendChild(r));
                }
                bind();
            }

            function paginate() {
                pagUl.innerHTML = '';
                const total = Math.ceil(filtered.length / rowsPerPage) || 1;
                for (let i = 1; i <= total; i++) {
                    const li = document.createElement('li');
                    li.className = 'page-item' + (i === page ? ' active' : '');
                    const a = document.createElement('a');
                    a.href = '#'; a.className = 'page-link'; a.textContent = i;
                    a.onclick = e => { e.preventDefault(); page = i; render(); paginate(); };
                    li.appendChild(a);
                    pagUl.appendChild(li);
                }
            }

            function filter() {
                const q = searchIn.value.toLowerCase();
                filtered = allRows.filter(r =>
                    [...r.cells].slice(1).some(td => td.textContent.toLowerCase().includes(q))
                );
                page = 1; render(); paginate();
            }

            function bind() {
                bodyEl.querySelectorAll('tr[data-id]').forEach(r => {
                    r.onclick = e => {
                        if (e.target.type !== 'checkbox') {
                            window.location = r.dataset.editUrl;
                        }
                    };
                });
                bodyEl.querySelectorAll('.rowCheckbox').forEach(cb => cb.onchange = updateBtns);
                selectAll.onchange = () => {
                    bodyEl.querySelectorAll('.rowCheckbox').forEach(cb => cb.checked = selectAll.checked);
                    updateBtns();
                };
                updateBtns();
            }

            function updateBtns() {
                const any = bodyEl.querySelector('.rowCheckbox:checked');
                toggleBtn.disabled = !any;
                deleteBtn.disabled = !any;
            }

            function submit(url) {
                const ids = [...bodyEl.querySelectorAll('.rowCheckbox:checked')].map(cb => cb.value).join(',');
                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ ids })
                }).then(_ => location.reload());
            }

            confirmToggle.onclick = () => submit("{{ path('admin_forms_toggle') }}");
            confirmDelete.onclick = () => submit("{{ path('admin_forms_delete') }}");

            searchIn.addEventListener('input', filter);
            render(); paginate();
        });
    </script>
{% endblock %}
