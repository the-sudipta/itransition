<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    {# Make Bootstrap’s responsive features work #}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="{{ asset('images/formulate_logo_icon.png') }}">

    <title>{% block title %}Formulate{% endblock %}</title>

    {# Boot­strap CSS (real existing version) #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet">

    {# Icons #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
        rel="stylesheet">

    {# in <head> or just before </body> #}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.10.1/lottie.min.js"
            integrity="sha512-/…"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    {% block stylesheets %}{% endblock %}
</head>
<body style="background-color: #FFFFFF;">


{# =============================================== #}
{# Flash messages (positioned in the bottom‐right) #}
{# =============================================== #}
<div class="position-fixed bottom-0 end-0 ps-3 pb-3" style="z-index:1080;">
    {% for label, messages in app.flashes %}
        {% set alertClass = (label == 'error' ? 'danger' : label) %}
        {% for message in messages %}
            <div
                class="alert alert-{{ alertClass }} alert-dismissible fade show"
                role="alert"
            >
                {{ message }}
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{% block body %}{% endblock %}

{# Boot­strap JS bundle #}
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
